<!--
  لوگوی «سیمرغ» — نسخه‌ی بهینه‌شده.
  - اندازه: 48dp × 48dp (viewport 48 × 48)
  - پالت:
      طلایی:      #F2BE58  (بال چپ، سر)
      فیروزه‌ای:  #20B8AE  (بال راست، منقار)
      کرم:        #FFF0C8  (بدنه و دم)
      سرمه‌ای:    #142D4E  (چشم)
  - سازگار با theme از طریق ?colorPrimaryVariant (در صورت استفاده از tint در کد).
  مسیر جایگزین برای: android/app/src/main/res/drawable/simorgh_logo.xml
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- بال چپ (طلایی) -->
    <path
        android:fillColor="#F2BE58"
        android:pathData="M23,22 C18,8 6,6 4,12 C8,12 10,17 12,21 C8,18 4,21 6,26 C12,23 17,26 22,31 Z" />

    <!-- بال راست (فیروزه‌ای) — آینه‌ی بال چپ -->
    <path
        android:fillColor="#20B8AE"
        android:pathData="M25,22 C30,8 42,6 44,12 C40,12 38,17 36,21 C40,18 44,21 42,26 C36,23 31,26 26,31 Z" />

    <!-- بدنه و دم (کرم) -->
    <path
        android:fillColor="#FFF0C8"
        android:pathData="M23,18 C19,23 20,34 26,42 C26,35 34,31 32,23 C31,18 26,15 23,18 Z" />

    <!-- سر (طلایی) -->
    <path
        android:fillColor="#F2BE58"
        android:pathData="M27,17 C26,11 30,7 35,9 C38,11 37,16 33,19 L29,24 Z" />

    <!-- منقار (فیروزه‌ای) — مثلث کوچک سمت راست -->
    <path
        android:fillColor="#20B8AE"
        android:pathData="M36,12 L44,15 L36,18 Z" />

    <!-- چشم (سرمه‌ای) — مستطیل 2×2 -->
    <path
        android:fillColor="#142D4E"
        android:pathData="M32,11 L34,11 L34,13 L32,13 Z" />
</vector>
