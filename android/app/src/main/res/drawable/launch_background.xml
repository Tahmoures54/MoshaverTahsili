<?xml version="1.0" encoding="utf-8"?>
<!--
    پس‌زمینه صفحه آغازین برنامه «سیمرغ».

    Resource:
        @drawable/launch_background

    وابستگی‌ها:
        @color/splash_bg
        @drawable/ic_education

    ویژگی‌ها:
        - پس‌زمینه یکدست با رنگ تعریف‌شده در splash_bg.
        - لوگوی چندرنگ با اندازه ثابت 144dp × 144dp.
        - قرارگیری لوگو در مرکز محدوده drawable.
        - بدون tint، برای حفظ رنگ‌های اصلی لوگو.

    سازگاری:
        - اندازه‌گذاری و gravity آیتم‌ها به API 23+ نیاز دارد.
        - این فایل برای windowBackground در LaunchTheme است.
        - صفحه آغازین سیستمی Android 12+ باید جداگانه
          در values-v31/styles.xml پیکربندی شود.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- لایه اول: پس‌زمینه تمام‌صفحه -->
    <item android:drawable="@color/splash_bg" />

    <!-- لایه دوم: لوگوی سیمرغ در مرکز -->
    <item
        android:width="144dp"
        android:height="144dp"
        android:gravity="center"
        android:drawable="@drawable/ic_education" />

</layer-list>
