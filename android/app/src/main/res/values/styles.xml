<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        تم پایه راه‌اندازی برنامه.

        در Android پایین‌تر از API 31، پس‌زمینه آغازین
        از launch_background.xml خوانده می‌شود.

        تنظیمات اسپلش سیستمی Android 12 و بالاتر
        در values-v31/styles.xml قرار می‌گیرند.
    -->
    <style
        name="LaunchTheme"
        parent="@android:style/Theme.Light.NoTitleBar">

        <!-- حذف عنوان و ActionBar -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>

        <!-- پس‌زمینه و لوگوی مرحله راه‌اندازی -->
        <item name="android:windowBackground">@drawable/launch_background</item>

        <!-- اجازه رنگ‌آمیزی نوارهای سیستم؛ از API 21 -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- هماهنگی نوارهای سیستم با پس‌زمینه اسپلش -->
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>

        <!-- آیکون‌های روشن روی پس‌زمینه سرمه‌ای -->
        <!-- از API 23 -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- از API 26 -->
        <item name="android:windowLightNavigationBar">false</item>

    </style>

    <!--
        تم عادی پنجره پس از راه‌اندازی.

        در پروژه Flutter، این تم از طریق metadata مربوط به
        io.flutter.embedding.android.NormalTheme معرفی می‌شود.

        رنگ رابط Flutter باید جداگانه در ThemeData تنظیم شود.
    -->
    <style
        name="NormalTheme"
        parent="@android:style/Theme.Light.NoTitleBar">

        <!-- حذف عنوان و ActionBar -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>

        <!-- پس‌زمینه پنجره پیش از نمایش محتوای Flutter -->
        <item name="android:windowBackground">@color/bg_light</item>

        <!-- اجازه رنگ‌آمیزی نوارهای سیستم -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- نوارهای سرمه‌ای مطابق colors.xml -->
        <item name="android:statusBarColor">@color/status_bar_light</item>
        <item name="android:navigationBarColor">@color/nav_bar_light</item>

        <!-- false یعنی آیکون‌های روشن برای نوارهای تیره -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

    </style>

</resources>
