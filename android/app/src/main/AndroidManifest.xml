<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- =========================================================
         دسترسی‌های موردنیاز
         ========================================================= -->

    <!-- ارتباط با سرور و دریافت محتوای آنلاین -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- بررسی وضعیت اتصال شبکه -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        فقط در صورت نیاز واقعی فعال شوند:

        <uses-permission android:name="android.permission.VIBRATE" />
        <uses-permission android:name="android.permission.WAKE_LOCK" />

        برخی افزونه‌ها مجوزهای موردنیاز خود را از طریق
        Manifest Merger اضافه می‌کنند.
    -->

    <!-- =========================================================
         ویژگی‌های دستگاه
         ========================================================= -->

    <!-- نصب روی دستگاه‌های بدون صفحه لمسی نیز مجاز است -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
        StrongBox اختیاری است.
        استفاده واقعی از آن نیازمند بررسی و پیاده‌سازی در کد است.
    -->
    <uses-feature
        android:name="android.hardware.strongbox_keystore"
        android:required="false" />

    <!-- =========================================================
         Package visibility در Android 11 و بالاتر

         این موارد برای بررسی برنامه‌های مقصد intentهای خروجی‌اند،
         نه برای دریافت intent توسط سیمرغ.
         ========================================================= -->

    <queries>

        <!-- بررسی برنامه‌های مناسب برای اشتراک‌گذاری متن -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>

        <!-- بررسی برنامه‌های مناسب برای بازکردن لینک HTTPS -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>

        <!-- پردازش متن انتخاب‌شده؛ مطابق نیاز Text Processing در Flutter -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>

    </queries>

    <!-- =========================================================
         تنظیمات برنامه
         ========================================================= -->

    <application
        android:name="${applicationName}"
        android:label="سیمرغ"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:appCategory="productivity"
        android:hardwareAccelerated="true">

        <!-- =====================================================
             Activity اصلی Flutter

             exported=true برای اجرای برنامه از Launcher و
             دریافت متن اشتراک‌گذاری‌شده لازم است.
             ===================================================== -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- تم عادی پنجره پس از مرحله راه‌اندازی Flutter -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- اجرای برنامه از Launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                دریافت متن اشتراک‌گذاری‌شده از برنامه‌های دیگر.

                فقط در صورتی نگه دارید که دریافت متن در کد
                Flutter یا native نیز پیاده‌سازی شده باشد.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>

        <!-- Flutter Android Embedding v2 -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

</manifest>
