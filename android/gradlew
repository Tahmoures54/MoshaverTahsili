# Modified from the supplied Gradle startup script:
# - Restored POSIX shell compatibility.
# - Replaced Bash read-array parsing with quote-aware xargs parsing
#   and shell-metacharacter escaping before eval.
# - Added checks for required Wrapper files and parsing tools.
#

##############################################################################
#
# Gradle Wrapper startup script for POSIX environments.
#
# Requirements:
#   - A POSIX-compatible shell.
#   - Java available through JAVA_HOME or PATH.
#   - Standard utilities, including xargs, sed and tr.
#
# The Gradle distribution version is configured in:
#   gradle/wrapper/gradle-wrapper.properties
#
# Gradle Daemon JVM settings belong in gradle.properties.
# DEFAULT_JVM_OPTS below controls the Wrapper launcher JVM.
#
##############################################################################

# Resolve the script location, including chained symbolic links.
app_path=$0

while
    APP_HOME=${app_path%"${app_path##*/}"}
    [ -h "$app_path" ]
do
    ls=$( ls -ld "$app_path" ) || exit 1
    link=${ls#*' -> '}

    case $link in
        /*)
            app_path=$link
            ;;
        *)
            app_path=$APP_HOME$link
            ;;
    esac
done

APP_BASE_NAME=${0##*/}

# Suppress cd output in case CDPATH is set.
APP_HOME=$(
    cd -P "${APP_HOME:-./}" > /dev/null &&
    printf '%s\n' "$PWD"
) || exit 1

MAX_FD=maximum

warn () {
    printf '%s\n' "$*"
} >&2

die () {
    printf '\n%s\n\n' "$*"
    exit 1
} >&2

# OS flags must contain either "true" or "false".
cygwin=false
msys=false
darwin=false
nonstop=false

case "$( uname )" in
    CYGWIN*)
        cygwin=true
        ;;
    Darwin*)
        darwin=true
        ;;
    MSYS* | MINGW*)
        msys=true
        ;;
    NONSTOP*)
        nonstop=true
        ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ ! -r "$CLASSPATH" ]; then
    die "ERROR: Gradle Wrapper JAR is missing or unreadable:
$CLASSPATH

Restore gradle/wrapper/gradle-wrapper.jar from a trusted source
or regenerate the Gradle Wrapper."
fi

if [ ! -r "$APP_HOME/gradle/wrapper/gradle-wrapper.properties" ]; then
    die "ERROR: Gradle Wrapper properties file is missing or unreadable:
$APP_HOME/gradle/wrapper/gradle-wrapper.properties"
fi

# Determine the Java command.
if [ -n "$JAVA_HOME" ]; then
    if [ -x "$JAVA_HOME/jre/sh/java" ]; then
        # IBM's JDK on AIX may use this executable location.
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi

    if [ ! -x "$JAVACMD" ]; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set JAVA_HOME to the location of a compatible Java installation."
    fi
else
    JAVACMD=java

    if ! command -v java > /dev/null 2>&1; then
        die "ERROR: JAVA_HOME is not set and no 'java' command was found in PATH.

Please set JAVA_HOME to the location of a compatible Java installation."
    fi
fi

# Increase the file descriptor limit where supported.
if ! "$cygwin" && ! "$darwin" && ! "$nonstop"; then
    case $MAX_FD in
        max*)
            # These ulimit options are not defined by POSIX.
            # Check whether the current shell supports them.
            # shellcheck disable=SC2039,SC3045
            MAX_FD=$( ulimit -H -n ) ||
                warn "Could not query maximum file descriptor limit"
            ;;
    esac

    case $MAX_FD in
        '' | soft)
            :
            ;;
        *)
            # shellcheck disable=SC2039,SC3045
            ulimit -n "$MAX_FD" ||
                warn "Could not set maximum file descriptor limit to $MAX_FD"
            ;;
    esac
fi

# Convert paths for Windows Java under Cygwin or MSYS.
if "$cygwin" || "$msys"; then
    if ! command -v cygpath > /dev/null 2>&1; then
        die "ERROR: cygpath is required under Cygwin or MSYS."
    fi

    APP_HOME=$( cygpath --path --mixed "$APP_HOME" ) || exit 1
    CLASSPATH=$( cygpath --path --mixed "$CLASSPATH" ) || exit 1
    JAVACMD=$( cygpath --unix "$JAVACMD" ) || exit 1

    # Convert positional arguments that look like existing POSIX paths.
    # Rotate the argument list once for each original argument.
    for arg do
        if
            case $arg in
                -*)
                    false
                    ;;
                /?*)
                    t=${arg#/}
                    t=/${t%%/*}
                    [ -e "$t" ]
                    ;;
                *)
                    false
                    ;;
            esac
        then
            arg=$( cygpath --path --ignore --mixed "$arg" ) || exit 1
        fi

        shift
        set -- "$@" "$arg"
    done
fi

# Defaults for the Wrapper launcher, not the Gradle Daemon.
# JAVA_OPTS and GRADLE_OPTS can supply additional JVM options.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m" "-Dfile.encoding=UTF-8"'

# Preserve all Gradle command-line arguments as separate arguments.
set -- \
    "-Dorg.gradle.appname=$APP_BASE_NAME" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"

# Required tools for quote-aware JVM-option parsing.
for tool in xargs sed tr; do
    if ! command -v "$tool" > /dev/null 2>&1; then
        die "ERROR: Required command '$tool' is not available in PATH."
    fi
done

# Parse quoted JVM options using xargs.
#
# These variables contain JVM options, not shell programs:
#   DEFAULT_JVM_OPTS
#   JAVA_OPTS
#   GRADLE_OPTS
#
# Shell substitutions embedded in their values are not evaluated.
# For example, a literal $(command) remains data.
#
# Newlines inside individual option values are not supported.
# Unmatched quotes or invalid escaping cause a parsing error.
#
# JAVA_OPTS and GRADLE_OPTS must still come from trusted sources:
# JVM options can change Java behavior even without shell execution.

_gradle_parsed_opts=$(
    printf '%s\n' "$DEFAULT_JVM_OPTS ${JAVA_OPTS:-} ${GRADLE_OPTS:-}" |
        xargs -n 1
) || die "ERROR: Could not parse JVM options.

Check JAVA_OPTS and GRADLE_OPTS for unmatched quotes or invalid escaping."

# Escape shell metacharacters in each parsed argument before using eval.
# Convert the escaped lines into a single shell argument list.
_gradle_escaped_opts=$(
    printf '%s\n' "$_gradle_parsed_opts" |
        sed 's~[^-[:alnum:]+,./:=@_]~\\&~g;' |
        tr '\n' ' '
) || die "ERROR: Could not prepare JVM options."

# Only the escaped option text is interpreted here.
# The original positional arguments remain protected by "$@".
eval "set -- $_gradle_escaped_opts"' "$@"'

exec "$JAVACMD" "$@"
