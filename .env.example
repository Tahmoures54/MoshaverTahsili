
# Simorgh Android build configuration
#
# IMPORTANT:
# The app does NOT load .env files at runtime.
# These values are supplied by GitHub Actions during the build.
#
# Required GitHub Actions Secret:
#   DEEPSEEK_API_KEY
#
# Optional GitHub Actions Variables or Secrets:
#   DEEPSEEK_API_ENDPOINT
#   DEEPSEEK_MODEL
#
# Legacy variable aliases are supported:
#   AI_API_KEY
#   AI_API_ENDPOINT
#   AI_MODEL
#
# Defaults:
#   API endpoint: https://api.avalai.ir/v1
#   AI model: deepseek-chat
#
# Never put real credentials in this file, Git history,
# issue comments, pull requests, build logs, or reports.

# Intentionally left empty.
